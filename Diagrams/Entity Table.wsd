@startuml

set namespaceSeparator ::

enum ResourceType{
}

struct Data::ConstructionCost{
    ResourceType Type
    float Cost
}

struct Data::BuildableInfo{
    FName Name
    BuildType type
    Image icon
    Color InfoBackgroundColor
    List<ConstructionCost> CostArr
}

struct Data::SpawnInfo{
    List<FName> BiomeEntityNames
    float BiomeScale
    int BiomeCount
    int SpawnPerBiome
    float RandomRotatingRange
    float ScaleRange
}

struct Data::InteractableInfo{
    FName Name
    bool RequireBuild
    bool EnableGroundBlend

    UStaticMeshArray MeshList

    ResourceType type

    float ResourceAmount
    float CollectionTime
    float CollectionValue
    bool EnableGroundBlend
    bool UseRandomMesh
}

class TableManager{
    List<BuildableInfo>BuildableInfoArr
    List<InteractableInfo> InteractableInfoArr
    List<SpawnInfo> SpawnInfoArr

    + GetValidBuildableInfos() : List<BuildableInfo>
    + GetValidSpawnInfos() : List<SpawnInfo>
    + GetValidInteractable(FName name) : InteractableInfo
}
'note up : Includes sifting through the contents of a table for valid items --\n ex) GetValidBuildableInfos: removes and returns items that are \nin the BuildableInfoArr but not in the InteractableInfoArr, based on Name


class Entity::InteractableBase{
    InteractableInfo Info
}

class Entity::BuildingBase{

}

class Entity::ResourceBase{

}

class Entity::EntityManager{
    List<InteractableBase> instances;

    + AddInteractable(InteractableBase) : void
}

class Spawner{
    + SpawnInteractable(FName name) : InteractableBase
}
note top : Factory

class UI::BuildEntityCardWidget{
    BuildableInfo Info
}


class UI::BuildPanelWidget{
    List<BuildEntityCardWidget> Cards
}
note left : By using GetValidBuildableItems, \n any BuildEntityCard can create an \n instance of InteractableBas


ConstructionCost -down-> ResourceType
BuildableInfo -down-> ConstructionCost
InteractableInfo -down-> ResourceType

TableManager --> BuildableInfo 
TableManager --> InteractableInfo
TableManager --> SpawnInfo
SpawnInfo -[hidden]right-> BuildableInfo
SpawnInfo -[hidden]down-> InteractableInfo
ConstructionCost -[hidden]right-> SpawnInfo

InteractableBase -left-> InteractableInfo
BuildingBase -up-|> InteractableBase
ResourceBase -up-|> InteractableBase

EntityManager --> InteractableBase

Spawner ..> TableManager : GetValidSpawnInfos
Spawner ..> TableManager : GetValidInteractable
Spawner ..> EntityManager : AddInteractable
Spawner --> InteractableBase

BuildEntityCardWidget --> BuildableInfo
BuildEntityCardWidget ..> Spawner

BuildPanelWidget ..> TableManager : GetValidBuildableItems
BuildPanelWidget --> BuildEntityCardWidget : Create


@enduml